<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#E8B04B"/><corners android:radius="20dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#3A3320"/><corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#E8B04B"/></shape>
    </item>
    <item>
        <shape><solid android:color="#1A1C23"/><corners android:radius="20dp"/></shape>
    </item>
</selector>
