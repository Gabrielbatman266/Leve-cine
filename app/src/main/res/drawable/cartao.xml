<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#2A2D38"/><corners android:radius="8dp"/>
            <stroke android:width="3dp" android:color="#E8B04B"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#2A2D38"/><corners android:radius="8dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#2A2D38"/><corners android:radius="8dp"/>
            <stroke android:width="3dp" android:color="#E8B04B"/></shape>
    </item>
    <item>
        <shape><solid android:color="#1A1C23"/><corners android:radius="8dp"/></shape>
    </item>
</selector>
